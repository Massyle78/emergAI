# =============================================================================
# emergAI - Environment Configuration Template
# Copy this file to .env and fill in your values. NEVER commit .env.
# =============================================================================

# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ---- FastAPI / Uvicorn ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ---- Google Gemini (via google-genai SDK) ----
GOOGLE_GENAI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-pro

# ---- Metriport (EHR Integration) ----
METRIPORT_API_KEY=your-metriport-api-key-here
METRIPORT_BASE_URL=https://api.metriport.com

# ---- Media Processing ----
MAX_VIDEO_SIZE_MB=50
MAX_AUDIO_SIZE_MB=20
ALLOWED_VIDEO_TYPES=video/webm,video/mp4
ALLOWED_AUDIO_TYPES=audio/webm,audio/wav,audio/mp3
TEMP_MEDIA_DIR=./tmp/media
